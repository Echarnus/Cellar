 /*
+ * Cellar: Fanatec wheel bases, driven over HID by SDL_cellar_fanatec.c.
+ */
+#ifdef SDL_JOYSTICK_IOKIT
+static Uint16 CellarHIDProperty(IOHIDDeviceRef device, CFStringRef key)
+{
+    CFTypeRef ref = IOHIDDeviceGetProperty(device, key);
+    int value = 0;
+    if (ref && CFGetTypeID(ref) == CFNumberGetTypeID()) {
+        CFNumberGetValue((CFNumberRef)ref, kCFNumberIntType, &value);
+    }
+    return (Uint16)value;
+}
+
+static bool CellarIsFanatecJoystick(SDL_Joystick *joystick)
+{
+    IOHIDDeviceRef device;
+    if (joystick->driver != &SDL_DARWIN_JoystickDriver || !joystick->hwdata || !joystick->hwdata->deviceRef) {
+        return false;
+    }
+    if (SDL_GetHintBoolean("CELLAR_FFB_DISABLE", false)) {
+        return false;
+    }
+    device = joystick->hwdata->deviceRef;
+    return CellarFanatec_IsSupported(CellarHIDProperty(device, CFSTR(kIOHIDVendorIDKey)),
+                                     CellarHIDProperty(device, CFSTR(kIOHIDProductIDKey)));
+}
+
+// The report the base takes commands on: its first output report, as hid-fanatecff uses.
+static CFIndex CellarFanatecReportID(IOHIDDeviceRef device)
+{
+    CFIndex report_id = 1;
+    CFArrayRef elements = IOHIDDeviceCopyMatchingElements(device, NULL, kIOHIDOptionsTypeNone);
+    if (elements) {
+        CFIndex i, count = CFArrayGetCount(elements);
+        for (i = 0; i < count; i++) {
+            IOHIDElementRef element = (IOHIDElementRef)CFArrayGetValueAtIndex(elements, i);
+            if (IOHIDElementGetType(element) == kIOHIDElementTypeOutput) {
+                report_id = (CFIndex)IOHIDElementGetReportID(element);
+                break;
+            }
+        }
+        CFRelease(elements);
+    }
+    return report_id;
+}
+
+static bool CellarFanatecSend(void *userdata, const Uint8 cmd[CELLAR_FANATEC_CMD_SIZE])
+{
+    struct haptic_hwdata *hwdata = (struct haptic_hwdata *)userdata;
+    Uint8 report[1 + CELLAR_FANATEC_CMD_SIZE];
+    const Uint8 *data = cmd;
+    CFIndex length = CELLAR_FANATEC_CMD_SIZE;
+
+    // With report IDs, macOS expects the ID as the first byte of the buffer.
+    if (hwdata->cellar_report_id != 0) {
+        report[0] = (Uint8)hwdata->cellar_report_id;
+        SDL_memcpy(&report[1], cmd, CELLAR_FANATEC_CMD_SIZE);
+        data = report;
+        length = sizeof(report);
+    }
+    return IOHIDDeviceSetReport(hwdata->cellar_device, kIOHIDReportTypeOutput, hwdata->cellar_report_id,
+                                data, length) == kIOReturnSuccess;
+}
+
+static bool CellarFanatecOpen(SDL_Haptic *haptic, SDL_Joystick *joystick)
+{
+    IOHIDDeviceRef device = joystick->hwdata->deviceRef;
+    struct haptic_hwdata *hwdata = (struct haptic_hwdata *)SDL_calloc(1, sizeof(*hwdata));
+    if (!hwdata) {
+        return false;
+    }
+    hwdata->cellar_device = (IOHIDDeviceRef)CFRetain(device);
+    hwdata->cellar_report_id = CellarFanatecReportID(device);
+    hwdata->cellar_fanatec = CellarFanatec_Create(CellarHIDProperty(device, CFSTR(kIOHIDProductIDKey)),
+                                                  CellarFanatecSend, hwdata,
+                                                  CellarFanatec_MaxPercentFromEnv(), true);
+    if (!hwdata->cellar_fanatec) {
+        CFRelease(hwdata->cellar_device);
+        SDL_free(hwdata);
+        return false;
+    }
+
+    haptic->effects = (struct haptic_effect *)SDL_calloc(CellarFanatec_NumEffects(), sizeof(struct haptic_effect));
+    if (!haptic->effects) {
+        CellarFanatec_Destroy(hwdata->cellar_fanatec);
+        CFRelease(hwdata->cellar_device);
+        SDL_free(hwdata);
+        return false;
+    }
+    haptic->hwdata = hwdata;
+    haptic->instance_id = SDL_GetNextObjectID();
+    haptic->name = SDL_strdup(joystick->name ? joystick->name : "Fanatec wheel base");
+    haptic->supported = CellarFanatec_GetFeatures();
+    haptic->neffects = CellarFanatec_NumEffects();
+    haptic->nplaying = haptic->neffects;
+    haptic->naxes = 1;
+    return true;
+}
