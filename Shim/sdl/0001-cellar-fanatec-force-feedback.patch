+  which declares MODULE_LICENSE("GPL"): GPL v2 or later, in the kernel's terms. The effect engine
+  follows SDL's lg4ff haptic driver (zlib). This file and its .c are therefore distributed under the
+  GPL, version 2 or later, as part of Cellar's SDL build.
+*/
+
+#ifndef SDL_cellar_fanatec_h_
+#define SDL_cellar_fanatec_h_
+
+#ifdef CELLAR_FFB_STANDALONE
+#include <SDL3/SDL.h>
+#endif
+
+#define CELLAR_FANATEC_VENDOR_ID 0x0eb7
+#define CELLAR_FANATEC_MAX_EFFECTS 16
+#define CELLAR_FANATEC_CMD_SIZE 7
+/* Default strength cap, in percent of the base's maximum torque. A direct-drive base at full
+   strength can hurt a hand; the player raises it on purpose (CELLAR_FFB_MAX_PERCENT). */
+#define CELLAR_FANATEC_DEFAULT_MAX_PERCENT 50
+
+/* Writes one 7-byte Fanatec command to the base. Returns false on failure. */
+typedef bool (*CellarFanatec_SendFunc)(void *userdata, const Uint8 cmd[CELLAR_FANATEC_CMD_SIZE]);
+
+typedef struct CellarFanatec CellarFanatec;
+
+/* Whether a vendor/product pair is a Fanatec wheel base with force feedback. */
+bool CellarFanatec_IsSupported(Uint16 vendor_id, Uint16 product_id);
+
+/* Whether the base takes 16-bit constant force (the DD and CSL Elite generations). */
+bool CellarFanatec_IsHighRes(Uint16 product_id);
+
+/* The steering range that tells the base to follow the game ("auto"), per hid-fanatecff. */
+Uint16 CellarFanatec_AutoRange(Uint16 product_id);
+
+/* The strength cap from CELLAR_FFB_MAX_PERCENT, clamped to 1..100; the default when unset. */
+int CellarFanatec_MaxPercentFromEnv(void);
+
+/* Opens the engine: sends the base's init sequence, disables every slot, and (with run_thread)
+   starts the 2 ms update thread. Returns NULL and sets an SDL error on failure. */
+CellarFanatec *CellarFanatec_Create(Uint16 product_id, CellarFanatec_SendFunc send, void *userdata,
+                                    int max_percent, bool run_thread);
+
+/* Stops every effect, tells the base to stop, joins the thread and frees the engine. */
+void CellarFanatec_Destroy(CellarFanatec *dev);
+
+Uint32 CellarFanatec_GetFeatures(void);
+int CellarFanatec_NumEffects(void);
+
+/* Effect calls, mirroring SDL_SYS_Haptic*. Ids are slots in 0..CELLAR_FANATEC_MAX_EFFECTS-1. */
+int CellarFanatec_NewEffect(CellarFanatec *dev, const SDL_HapticEffect *effect);
+bool CellarFanatec_UpdateEffect(CellarFanatec *dev, int id, const SDL_HapticEffect *effect);
+bool CellarFanatec_RunEffect(CellarFanatec *dev, int id, Uint32 iterations);
+bool CellarFanatec_StopEffect(CellarFanatec *dev, int id);
+void CellarFanatec_DestroyEffect(CellarFanatec *dev, int id);
+int CellarFanatec_GetEffectStatus(CellarFanatec *dev, int id);
+bool CellarFanatec_SetGain(CellarFanatec *dev, int gain);
+bool CellarFanatec_StopAll(CellarFanatec *dev);
+bool CellarFanatec_Pause(CellarFanatec *dev);
+bool CellarFanatec_Resume(CellarFanatec *dev);
+
+/* One engine step at time now_ms: what the thread does every 2 ms. Exposed for tests. */
+int CellarFanatec_Tick(CellarFanatec *dev, Uint64 now_ms);
+
+#endif /* SDL_cellar_fanatec_h_ */
