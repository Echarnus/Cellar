+#ifndef SDL_cellar_thrustmaster_h_
+#define SDL_cellar_thrustmaster_h_
+
+#ifdef CELLAR_FFB_STANDALONE
+#include <SDL3/SDL.h>
+#endif
+
+#define CELLAR_THRUSTMASTER_VENDOR_ID 0x044f
+#define CELLAR_THRUSTMASTER_MAX_EFFECTS 16
+/* The HID output report every command travels in. The wheel takes it whatever its descriptor says. */
+#define CELLAR_THRUSTMASTER_REPORT_ID 0x60
+#define CELLAR_THRUSTMASTER_MAX_BUFFER 63
+/* A belt-driven base is far weaker than a direct-drive one: the game's own strength, by default. */
+#define CELLAR_THRUSTMASTER_DEFAULT_MAX_PERCENT 100
+/* The wheel drops commands that come faster than this (hid-tmff2's timer period). */
+#define CELLAR_THRUSTMASTER_TICK_MS 8
+
+/* Writes one command (`len` bytes, without the report ID) to the wheel. Returns false on failure. */
+typedef bool (*CellarThrustmaster_SendFunc)(void *userdata, const Uint8 *buffer, int len);
+
+typedef struct CellarThrustmaster CellarThrustmaster;
+
+/* Whether a vendor/product pair is a T300-family wheel in its force-feedback mode. A wheel that
+   still reports the generic "FFB Wheel" product (0xb65d) has to be switched out of it first. */
+bool CellarThrustmaster_IsSupported(Uint16 vendor_id, Uint16 product_id);
+
+/* The generic mode every Thrustmaster wheel starts in, before the host switches it to its own. */
+#define CELLAR_THRUSTMASTER_GENERIC_PRODUCT_ID 0xb65d
+
+/* The mode switch for a wheel still in the generic mode: given the wheel's answer to the vendor
+   request 73 (bmRequestType 0xc1, 16 bytes), the wValue of request 83 (bmRequestType 0x41) that
+   switches it to the mode this engine drives. 0 for a wheel this engine does not drive. */
+Uint16 CellarThrustmaster_SwitchValue(const Uint8 *response, int length);
+
+/* The length of one command for this product: 31 bytes in PS4 mode, 63 otherwise. */
+int CellarThrustmaster_BufferLength(Uint16 product_id);
+
+/* The strength cap from CELLAR_FFB_MAX_PERCENT, clamped to 1..100; 100 when unset. */
+int CellarThrustmaster_MaxPercentFromEnv(void);
+
+/* Opens the engine: sends the wheel's open sequence, its steering range and gain, and (with
+   run_thread) starts the update thread. Returns NULL and sets an SDL error on failure. */
+CellarThrustmaster *CellarThrustmaster_Create(Uint16 product_id, CellarThrustmaster_SendFunc send,
+                                              void *userdata, int max_percent, bool run_thread);
+
+/* Stops every effect, sends the wheel's close sequence, joins the thread and frees the engine. */
+void CellarThrustmaster_Destroy(CellarThrustmaster *dev);
+
+Uint32 CellarThrustmaster_GetFeatures(void);
+int CellarThrustmaster_NumEffects(void);
+
+/* Effect calls, mirroring SDL_SYS_Haptic*. Ids are slots in 0..CELLAR_THRUSTMASTER_MAX_EFFECTS-1. */
+int CellarThrustmaster_NewEffect(CellarThrustmaster *dev, const SDL_HapticEffect *effect);
+bool CellarThrustmaster_UpdateEffect(CellarThrustmaster *dev, int id, const SDL_HapticEffect *effect);
+bool CellarThrustmaster_RunEffect(CellarThrustmaster *dev, int id, Uint32 iterations);
+bool CellarThrustmaster_StopEffect(CellarThrustmaster *dev, int id);
+void CellarThrustmaster_DestroyEffect(CellarThrustmaster *dev, int id);
+int CellarThrustmaster_GetEffectStatus(CellarThrustmaster *dev, int id);
+bool CellarThrustmaster_SetGain(CellarThrustmaster *dev, int gain);
+bool CellarThrustmaster_SetAutocenter(CellarThrustmaster *dev, int autocenter);
+bool CellarThrustmaster_StopAll(CellarThrustmaster *dev);
+
+/* One engine step at time now_ms: sends what the game queued since the last one. What the thread
+   does every CELLAR_THRUSTMASTER_TICK_MS. Exposed for tests. */
+int CellarThrustmaster_Tick(CellarThrustmaster *dev, Uint64 now_ms);
+
+#endif /* SDL_cellar_thrustmaster_h_ */
