 }
+
+/*
+ * Cellar: Thrustmaster T300-family wheels, driven over HID by SDL_cellar_thrustmaster.c.
+ */
+// The product ID of a Thrustmaster joystick, or 0 for any other (or with CELLAR_FFB_DISABLE set).
+static Uint16 CellarThrustmasterProduct(SDL_Joystick *joystick)
+{
+    IOHIDDeviceRef device;
+    if (joystick->driver != &SDL_DARWIN_JoystickDriver || !joystick->hwdata || !joystick->hwdata->deviceRef) {
+        return 0;
+    }
+    if (SDL_GetHintBoolean("CELLAR_FFB_DISABLE", false)) {
+        return 0;
+    }
+    device = joystick->hwdata->deviceRef;
+    if (CellarHIDProperty(device, CFSTR(kIOHIDVendorIDKey)) != CELLAR_THRUSTMASTER_VENDOR_ID) {
+        return 0;
+    }
+    return CellarHIDProperty(device, CFSTR(kIOHIDProductIDKey));
+}
+
+static bool CellarIsThrustmasterFFBJoystick(SDL_Joystick *joystick)
+{
+    return CellarThrustmaster_IsSupported(CELLAR_THRUSTMASTER_VENDOR_ID, CellarThrustmasterProduct(joystick));
+}
+
+// The USB device behind a HID device: the first IOUSBHostDevice (or older IOUSBDevice) above it.
+static io_service_t CellarUSBDeviceFor(IOHIDDeviceRef hid)
+{
+    io_registry_entry_t entry = IOHIDDeviceGetService(hid);
+    if (!entry) {
+        return 0;
+    }
+    IOObjectRetain(entry);
+    while (entry) {
+        io_registry_entry_t parent = 0;
+        kern_return_t kr;
+        if (IOObjectConformsTo(entry, "IOUSBHostDevice") || IOObjectConformsTo(entry, "IOUSBDevice")) {
+            return entry;
+        }
+        kr = IORegistryEntryGetParentEntry(entry, kIOServicePlane, &parent);
+        IOObjectRelease(entry);
+        entry = kr == KERN_SUCCESS ? parent : 0;
+    }
+    return 0;
+}
+
+static IOReturn CellarUSBRequest(IOUSBDeviceInterface **usb, IOUSBDevRequest *request)
+{
+    IOReturn ret = (*usb)->DeviceRequest(usb, request);
+    if (ret == kIOReturnNotOpen && (*usb)->USBDeviceOpen(usb) == kIOReturnSuccess) {
+        ret = (*usb)->DeviceRequest(usb, request);
+        (*usb)->USBDeviceClose(usb);
+    }
+    return ret;
+}
+
+/* A Thrustmaster wheel starts as a generic "FFB Wheel" (0xb65d) with no force feedback, until the
+   host asks its model (vendor request 73) and switches it (request 83) - what Thrustmaster's Windows
+   driver and Linux's hid-thrustmaster do. The wheel then drops off the bus and comes back as its own
+   product, which SDL sees as a new joystick that CellarIsThrustmasterFFBJoystick takes. */
+static void CellarThrustmasterSwitchMode(IOHIDDeviceRef hid)
+{
+    // The packets Linux sends first: some T300s fail the switch without them.
+    static const Uint8 setup[5][9] = {
+        { 0x42, 0x01 }, { 0x0a, 0x04, 0x90, 0x03 }, { 0x0a, 0x04, 0x00, 0x0c }, { 0x0a, 0x04, 0x12, 0x10 }, { 0x0a, 0x04, 0x00, 0x06 }
+    };
+    static const CFIndex setup_lengths[5] = { 9, 8, 8, 8, 8 };
+    static SInt64 attempted[8];
+    static int nattempted = 0;
+    CFTypeRef location_ref = IOHIDDeviceGetProperty(hid, CFSTR(kIOHIDLocationIDKey));
+    SInt64 location = 0;
+    io_service_t service;
+    IOCFPlugInInterface **plugin = NULL;
+    IOUSBDeviceInterface **usb = NULL;
+    SInt32 score = 0;
+    Uint8 response[16];
+    IOUSBDevRequest request;
+    Uint16 value;
+    int i;
+
+    // One attempt per wheel per process: an unknown model must not be asked again on every scan.
+    if (location_ref && CFGetTypeID(location_ref) == CFNumberGetTypeID()) {
+        CFNumberGetValue((CFNumberRef)location_ref, kCFNumberSInt64Type, &location);
+    }
+    for (i = 0; i < nattempted; i++) {
+        if (attempted[i] == location) {
+            return;
+        }
+    }
+    if (nattempted < (int)SDL_arraysize(attempted)) {
+        attempted[nattempted++] = location;
+    }
+
+    service = CellarUSBDeviceFor(hid);
+    if (!service) {
+        return;
+    }
+    if (IOCreatePlugInInterfaceForService(service, kIOUSBDeviceUserClientTypeID, kIOCFPlugInInterfaceID,
+                                          &plugin, &score) != KERN_SUCCESS || !plugin) {
+        IOObjectRelease(service);
+        return;
+    }
+    IOObjectRelease(service);
+    (*plugin)->QueryInterface(plugin, CFUUIDGetUUIDBytes(kIOUSBDeviceInterfaceID), (LPVOID *)&usb);
+    IODestroyPlugInInterface(plugin);
+    if (!usb) {
+        return;
+    }
+
+    for (i = 0; i < 5; i++) {
+        IOHIDDeviceSetReport(hid, kIOHIDReportTypeOutput, 0, setup[i], setup_lengths[i]);
+    }
+
+    SDL_zero(response);
+    SDL_zero(request);
+    request.bmRequestType = 0xc1;
+    request.bRequest = 73;
+    request.wLength = sizeof(response);
+    request.pData = response;
+    if (CellarUSBRequest(usb, &request) == kIOReturnSuccess) {
+        value = CellarThrustmaster_SwitchValue(response, (int)request.wLenDone);
+        if (value) {
+            SDL_zero(request);
+            request.bmRequestType = 0x41;
+            request.bRequest = 83;
+            request.wValue = value;
+            // The wheel resets before it answers: no reply is the expected outcome.
+            CellarUSBRequest(usb, &request);
+        }
+    }
+    (*usb)->Release(usb);
+}
+
+static bool CellarThrustmasterSend(void *userdata, const Uint8 *buffer, int len)
+{
+    struct haptic_hwdata *hwdata = (struct haptic_hwdata *)userdata;
+    Uint8 report[1 + CELLAR_THRUSTMASTER_MAX_BUFFER];
+    if (len > CELLAR_THRUSTMASTER_MAX_BUFFER) {
+        return false;
+    }
+    // Every command is output report 0x60, ID first, as hid-tmff2 sends it.
+    report[0] = CELLAR_THRUSTMASTER_REPORT_ID;
+    SDL_memcpy(&report[1], buffer, (size_t)len);
+    return IOHIDDeviceSetReport(hwdata->cellar_device, kIOHIDReportTypeOutput, CELLAR_THRUSTMASTER_REPORT_ID,
+                                report, 1 + len) == kIOReturnSuccess;
+}
+
+static bool CellarThrustmasterOpen(SDL_Haptic *haptic, SDL_Joystick *joystick)
+{
+    IOHIDDeviceRef device = joystick->hwdata->deviceRef;
+    struct haptic_hwdata *hwdata = (struct haptic_hwdata *)SDL_calloc(1, sizeof(*hwdata));
+    if (!hwdata) {
+        return false;
+    }
+    hwdata->cellar_device = (IOHIDDeviceRef)CFRetain(device);
+    hwdata->cellar_report_id = CELLAR_THRUSTMASTER_REPORT_ID;
+    hwdata->cellar_thrustmaster = CellarThrustmaster_Create(CellarHIDProperty(device, CFSTR(kIOHIDProductIDKey)),
+                                                            CellarThrustmasterSend, hwdata,
+                                                            CellarThrustmaster_MaxPercentFromEnv(), true);
+    if (!hwdata->cellar_thrustmaster) {
+        CFRelease(hwdata->cellar_device);
+        SDL_free(hwdata);
+        return false;
+    }
+
+    haptic->effects = (struct haptic_effect *)SDL_calloc(CellarThrustmaster_NumEffects(), sizeof(struct haptic_effect));
+    if (!haptic->effects) {
+        CellarThrustmaster_Destroy(hwdata->cellar_thrustmaster);
+        CFRelease(hwdata->cellar_device);
+        SDL_free(hwdata);
+        return false;
+    }
+    haptic->hwdata = hwdata;
+    haptic->instance_id = SDL_GetNextObjectID();
+    haptic->name = SDL_strdup(joystick->name ? joystick->name : "Thrustmaster wheel");
+    haptic->supported = CellarThrustmaster_GetFeatures();
+    haptic->neffects = CellarThrustmaster_NumEffects();
+    haptic->nplaying = haptic->neffects;
+    haptic->naxes = 1;
+    return true;
+}
